{
  "name": "adaptive-material-ui",
  "description": "Collection of React components based off the MUI library which adapt to the current device",
  "license": "MIT",
  "version": "2.1.0",
  "homepage": "https://unimorphic.github.io/adaptive-material-ui/",
  "keywords": [
    "adaptive",
    "react",
    "react-component",
    "mui",
    "material-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unimorphic/adaptive-material-ui.git"
  },
  "private": true,
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      }
    },
    "./adaptiveMode": {
      "require": {
        "types": "./dist/adaptiveMode/index.d.ts",
        "default": "./dist/adaptiveMode/index.js"
      },
      "default": {
        "types": "./dist/esm/adaptiveMode/index.d.ts",
        "default": "./dist/esm/adaptiveMode/index.mjs"
      }
    },
    "./eslintRule": {
      "require": {
        "types": "./dist/eslintRule.d.ts",
        "default": "./dist/eslintRule.js"
      },
      "default": {
        "types": "./dist/esm/eslintRule.d.ts",
        "default": "./dist/esm/eslintRule.mjs"
      }
    },
    "./components/*": {
      "require": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      },
      "default": {
        "types": "./dist/esm/components/*/index.d.ts",
        "default": "./dist/esm/components/*/index.mjs"
      }
    },
    "./theme/*": {
      "require": {
        "types": "./dist/theme/*.d.ts",
        "default": "./dist/theme/*.js"
      },
      "default": {
        "types": "./dist/esm/theme/*.d.ts",
        "default": "./dist/esm/theme/*.mjs"
      }
    }
  },
  "scripts": {
    "build": "rslib build",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint . && tsc && cd docs && tsc",
    "pack": "pnpm run build && node scripts/preparePackage.cjs && cd dist && pnpm pack",
    "publish": "pnpm run build && node scripts/preparePackage.cjs && cd dist && pnpm publish --tag latest",
    "start": "rslib build --watch --env-mode development",
    "start-docs": "concurrently --kill-others \"pnpm run start\" \"cd docs && pnpm run start\"",
    "test": "vitest",
    "test-ct": "playwright test -c playwright-ct.config.ts",
    "test-ct-debug": "playwright test --ui -c playwright-ct.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@mui/types": "9.0.0",
    "@playwright/experimental-ct-react": "1.59.1",
    "@rsbuild/plugin-react": "2.0.0",
    "@rslib/core": "0.21.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-mdx": "3.7.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.0.2",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@mui/material": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0",
    "@mui/system": "9.0.0",
    "@mui/utils": "9.0.0",
    "clsx": "2.1.1",
    "invert-color": "2.0.0"
  },
  "peerDependenciesMeta": {
    "@emotion/react": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    }
  }
}
